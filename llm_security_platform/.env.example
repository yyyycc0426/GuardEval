LLM_SECURITY_API_KEY=replace-with-a-local-api-key
LLM_SECURITY_DATABASE_PATH=llm_security_platform/security_eval.db
LLM_SECURITY_DATABASE_URL=sqlite:///llm_security_platform/stage_five.db
LLM_SECURITY_REDIS_URL=redis://localhost:6379/0
LLM_SECURITY_CELERY_EAGER=false
# Optional JSON map: {"custom-key":{"actor":"alice","role":"analyst"}}
LLM_SECURITY_API_KEYS_JSON=

# Local Ollama target
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Any OpenAI-compatible target such as DeepSeek
LLM_SECURITY_MODEL_BASE_URL=https://api.deepseek.com
LLM_SECURITY_MODEL_API_KEY=
LLM_SECURITY_MODEL_NAME=deepseek-chat
